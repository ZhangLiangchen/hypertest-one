# No credentials here. Replace image placeholders with build-images.sh output.
HYPERTEST_STACK_NAME=hypertest-production
HYPERTEST_API_IMAGE=sha256:REPLACE
HYPERTEST_WORKER_IMAGE=sha256:REPLACE
HYPERTEST_WEB_IMAGE=sha256:REPLACE
HYPERTEST_POSTGRES_IMAGE=sha256:REPLACE
HYPERTEST_NGINX_IMAGE=sha256:REPLACE
HYPERTEST_UID=999
HYPERTEST_GID=999
HYPERTEST_DOCKER_GID=REPLACE_WITH_SOCKET_GID
HYPERTEST_BRIDGE_GID=REPLACE_WITH_SHARED_GROUP_GID
HYPERTEST_PLATFORM_ENV_FILE=/etc/hypertest/container/platform.env
HYPERTEST_POSTGRES_ENV_FILE=/etc/hypertest/postgres.env
HYPERTEST_ARTIFACT_ROOT=/var/lib/hypertest/artifacts
HYPERTEST_WORKSPACE_ROOT=/var/lib/hypertest/workspaces
HYPERTEST_BRIDGE_SOCKET_DIR=/run/hypertest-harness
HYPERTEST_BRIDGE_EXECUTION_KEY_FILE=/etc/hypertest/container/bridge-execution.key
HYPERTEST_BRIDGE_MANAGEMENT_KEY_FILE=/etc/hypertest/container/bridge-management.key
HYPERTEST_BRIDGE_HOST_ID=hypertest-one-primary
HYPERTEST_NGINX_CONFIG=/etc/hypertest/container/nginx.conf
HYPERTEST_POSTGRES_VOLUME=hypertest_pgdata
HYPERTEST_POSTGRES_PORT=5432
HYPERTEST_API_PORT=8000
HYPERTEST_WEB_PORT=3000
HYPERTEST_INGRESS_PORT=8080
HYPERTEST_PUBLIC_INGRESS=enabled
# Documentation-only addresses: preserve the existing protected host values.
HYPERTEST_PUBLIC_IP=203.0.113.10
HYPERTEST_VPN_CIDR=198.51.100.7/32
