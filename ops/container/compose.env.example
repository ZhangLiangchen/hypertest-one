# No credentials here. Replace image placeholders with build-images.sh output.
HYPERTEST_STACK_NAME=hypertest-production
HYPERTEST_API_IMAGE=sha256:REPLACE
HYPERTEST_WORKER_IMAGE=sha256:REPLACE
HYPERTEST_WEB_IMAGE=sha256:REPLACE
HYPERTEST_POSTGRES_IMAGE=sha256:REPLACE
HYPERTEST_NGINX_IMAGE=sha256:REPLACE
HYPERTEST_UID=999
HYPERTEST_GID=999
HYPERTEST_DOCKER_GID=REPLACE_WITH_SOCKET_GID
HYPERTEST_BRIDGE_GID=REPLACE_WITH_SHARED_GROUP_GID
HYPERTEST_PLATFORM_ENV_FILE=/etc/hypertest/container/platform.env
HYPERTEST_POSTGRES_ENV_FILE=/etc/hypertest/postgres.env
HYPERTEST_ARTIFACT_ROOT=/var/lib/hypertest/artifacts
HYPERTEST_WORKSPACE_ROOT=/var/lib/hypertest/workspaces
HYPERTEST_BRIDGE_SOCKET_DIR=/run/hypertest-harness
HYPERTEST_BRIDGE_EXECUTION_KEY_FILE=/etc/hypertest/container/bridge-execution.key
HYPERTEST_BRIDGE_MANAGEMENT_KEY_FILE=/etc/hypertest/container/bridge-management.key
HYPERTEST_BRIDGE_HOST_ID=hypertest-one-primary
HYPERTEST_NGINX_CONFIG=/etc/hypertest/container/nginx.conf
HYPERTEST_POSTGRES_VOLUME=hypertest_pgdata
HYPERTEST_POSTGRES_PORT=5432
HYPERTEST_API_PORT=8000
HYPERTEST_WEB_PORT=3000
HYPERTEST_INGRESS_PORT=8080
HYPERTEST_PUBLIC_INGRESS=enabled
# Documentation-only addresses: preserve the existing protected host values.
HYPERTEST_PUBLIC_IP=203.0.113.10
HYPERTEST_VPN_CIDR=198.51.100.7/32
# Optional: upgrade only the existing public IP:INGRESS_PORT to HTTPS/WSS.
# Leave disabled for the accepted HTTP/server Harness baseline.
HYPERTEST_INGRESS_TLS=disabled
# Independent Cloud control-plane opt-in; new Worker is a host systemd service.
HYPERTEST_CLOUD_WEB=disabled
# Independent experience Gateway; never implies Cloud or Local task rights.
HYPERTEST_MEMORY_GATEWAY=disabled
# HYPERTEST_MEMORY_POWERCONTEXT_ORIGIN=https://powercontext.example.com:8443
# HYPERTEST_MEMORY_POWERCONTEXT_TOKEN_FILE=/etc/hypertest/memory/api-powercontext-token
# HYPERTEST_MEMORY_WORKER_SOCKET_DIR=/run/hypertest-memory-worker
# Memory Web shares the strict Web transport origin/CA/socket/Operator fields
# below even when HYPERTEST_CLOUD_WEB stays disabled. Wrapping keys and Cloud
# Worker flags remain requirements only of the independent Cloud overlay.
# Set only after private provisioning and public issuer/SAN validation.
# HYPERTEST_CLOUD_API_ORIGIN=https://203.0.113.10:8080
# HYPERTEST_CLOUD_WEB_SOCKET_DIR=/run/hypertest-cloud-web
# HYPERTEST_CLOUD_API_CA_FILE=/etc/hypertest/cloud-platform/issuer-ca.crt
# HYPERTEST_CLOUD_API_WRAPPING_KEY_FILE=/etc/hypertest/cloud-platform/RELEASE/api-wrapping-key
# HYPERTEST_CLOUD_WEB_OPERATOR_KEY_FILE=/etc/hypertest/cloud-platform/RELEASE/web-operator-key
# HYPERTEST_CLOUD_CREDENTIAL_KEY_ID=primary
# HYPERTEST_CLOUD_WORKER_ENABLED=true
# HYPERTEST_CLOUD_CODEX_ENABLED=false
# Set these absolute existing file paths only when TLS is enabled.
# HYPERTEST_TLS_CERT_FILE=/etc/hypertest/container/tls/server.crt
# HYPERTEST_TLS_KEY_FILE=/etc/hypertest/container/tls/server.key
# Optional lowercase DNS name; otherwise use the existing PUBLIC_IP (certificate SAN).
# HYPERTEST_TLS_SERVER_NAME=hypertest.example.com
