HYPERTEST_BRIDGE_SOCKET=/run/hypertest-harness/harness.sock
HYPERTEST_BRIDGE_TOOL_SOCKET=/run/hypertest-harness/relay.sock
HYPERTEST_BRIDGE_EXECUTION_KEY_FILE=/etc/hypertest/container/bridge-execution.key
HYPERTEST_BRIDGE_MANAGEMENT_KEY_FILE=/etc/hypertest/container/bridge-management.key
HYPERTEST_BRIDGE_HOST_ID=hypertest-one-primary
HYPERTEST_BRIDGE_STATE_DIR=/var/lib/hypertest-harness
HYPERTEST_BRIDGE_WORKSPACE_ROOT=/var/lib/hypertest/workspaces/.hypertest-agent-sessions
HYPERTEST_BRIDGE_CODEX_BINARY=/opt/hypertest/codex/bin/codex
HYPERTEST_BRIDGE_MAX_CONCURRENT=1
