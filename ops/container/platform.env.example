# Copy into a protected root:hypertest 0640 file; preserve existing credentials.
# DB host changes to the Compose service name; user/password/database do not change.
HYPERTEST_ENV=production
HYPERTEST_DATABASE_URL=postgresql+asyncpg://hypertest:REPLACE_URL_ENCODED_PASSWORD@postgres:5432/hypertest
HYPERTEST_EXECUTION_MODE=queued
HYPERTEST_HARNESS_MODE=bridge
HYPERTEST_BRIDGE_HOST_ID=hypertest-one-primary
HYPERTEST_ARTIFACT_ROOT=/var/lib/hypertest/artifacts
HYPERTEST_WORKSPACE_ROOT=/var/lib/hypertest/workspaces
# Frozen historical images must remain available; fill actual IDs from local inspect.
HYPERTEST_RUNNER_IMAGE=sha256:REPLACE
HYPERTEST_RUNNER_CONTROLLED_IMAGE=sha256:REPLACE
HYPERTEST_RUNNER_API_IMAGE=sha256:REPLACE
HYPERTEST_RUNNER_API_V2_IMAGE=sha256:REPLACE
HYPERTEST_WORKER_POLL_SECONDS=1
HYPERTEST_WORKER_LEASE_SECONDS=30
HYPERTEST_WORKER_HEARTBEAT_SECONDS=5
