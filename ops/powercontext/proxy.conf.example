# Render POWERCONTEXT_HOST from the protected deployment profile before use.
# Keep that rendered address and the actual endpoint outside this repository.
daemon off;
master_process on;
pid /run/powercontext-proxy/nginx.pid;
error_log stderr warn;
worker_processes 1;
events { worker_connections 128; }
http {
  access_log off;
  server_tokens off;
  client_body_temp_path /var/lib/powercontext-proxy/body;
  proxy_temp_path /var/lib/powercontext-proxy/proxy;
  fastcgi_temp_path /var/lib/powercontext-proxy/fastcgi;
  uwsgi_temp_path /var/lib/powercontext-proxy/uwsgi;
  scgi_temp_path /var/lib/powercontext-proxy/scgi;
  map $http_host $host_allowed {
    default 0;
    "POWERCONTEXT_HOST:8443" 1;
    "POWERCONTEXT_HOST" 1;
  }
  map $http_origin $origin_allowed {
    default 0;
    "" 1;
    "https://POWERCONTEXT_HOST:8443" 1;
  }
  server {
    listen POWERCONTEXT_HOST:8443 ssl;
    server_name POWERCONTEXT_HOST;
    if ($host_allowed = 0) { return 421; }
    if ($origin_allowed = 0) { return 403; }
    ssl_certificate /etc/powercontext/proxy-tls/current/fullchain.pem;
    ssl_certificate_key /etc/powercontext/proxy-tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PowerContextTLS:1m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header X-Content-Type-Options nosniff always;
    client_max_body_size 8m;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    location = /health/live { proxy_pass http://127.0.0.1:8000; }
    location = /health/ready { proxy_pass http://127.0.0.1:8000; }
    location /v1/ { proxy_pass http://127.0.0.1:8000; }
    location ~ ^/mcp(?:/|$) { proxy_pass http://127.0.0.1:8000; }
    location / { return 404; }
  }
}
