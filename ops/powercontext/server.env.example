# Generate the real token on the server. Keep the real file root:root 0600.
# systemd loads it; do not pass its value in arguments or agent configuration.
POWERCONTEXT_HOME=/var/lib/powercontext
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_ACCESS_MODE=enforced
POWERCONTEXT_SERVER_AUTH_TOKEN=REPLACE_WITH_SERVER_GENERATED_PRIVATE_TOKEN
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=false
POWERCONTEXT_SERVER_RUNTIME_ARTIFACT_PROCESSING_FAMILIES=[]
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
