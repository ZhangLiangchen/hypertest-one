# PREPARATION ONLY. Copy to a protected root-owned service config, outside release.
# Replace the database placeholder privately; never pass the value as an argv.
# Existing container-only hostname "postgres" is not the host service endpoint.
HYPERTEST_DATABASE_URL=postgresql+asyncpg://hypertest:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/hypertest
HYPERTEST_ENV=production
# Keep disabled until explicit deployment/resource/model authorization and review.
HYPERTEST_CLOUD_ENABLED=false
HYPERTEST_CLOUD_WORKER_ENABLED=false
HYPERTEST_CLOUD_CREDENTIAL_KEY_ID=primary
HYPERTEST_CLOUD_MODEL_BASE_URL=https://api.deepseek.com/anthropic
HYPERTEST_CLOUD_MODEL=deepseek-flash
# Explicit bounded example, not a statement of production acceptance or price.
HYPERTEST_CLOUD_MODEL_MAX_TOKENS=16384
HYPERTEST_CLOUD_MODEL_MAX_REQUESTS=32
# Zero deliberately blocks execution. Set a separately approved conservative
# micro-unit rate, or an explicit Task REQUEST_CREDITS rate under its own budget.
HYPERTEST_CLOUD_MODEL_REQUEST_COST_MICROUNITS=0
HYPERTEST_CLOUD_ATTEMPT_TIMEOUT_SECONDS=900
HYPERTEST_CLOUD_WORKER_LEASE_SECONDS=90
HYPERTEST_CLOUD_WORKER_POLL_SECONDS=2
# Do not add credential paths, CREDENTIALS_DIRECTORY, runtime root, release SHA,
# or Codex flags:
# these belong to the reviewed unit / explicit Codex drop-in. EnvironmentFile has
# higher precedence than Environment; admission rejects mismatched key paths.
# API and Worker must use the same wrapping key/key-id for encrypted Project data.
