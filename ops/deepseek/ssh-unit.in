#!/bin/sh
# Installed root-owned 0555. Preserve only systemd's validated public identity.
case "${INVOCATION_ID-}" in
  ''|*[!0-9a-f]*) exit 2 ;;
esac
[ "${#INVOCATION_ID}" -eq 32 ] || exit 2
exec /usr/bin/env -i INVOCATION_ID="$INVOCATION_ID" PATH=/usr/bin:/bin LANG=C.UTF-8 \
  PYTHONPATH=@HELPER_SOURCE_ROOT@ PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
  /usr/bin/python3 -m hypertest.cloud.ssh_remote run-unit "$@"
