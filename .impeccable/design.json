      "description": "A labeled, readable white control with the existing theme border and focus response.",
      "html": "<label class=\"ds-label\" for=\"ds-search\">Search projects</label><input id=\"ds-search\" class=\"ds-input\" placeholder=\"Search name, key or repository\" />",
      "css": ".ds-label{display:block;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:14px;color:var(--ht-ink,#172338);margin-bottom:8px}.ds-input{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:14px;height:36px;padding:4px 11px;border:1px solid #8190a5;border-radius:6px;background:var(--ht-surface,#ffffff);color:var(--ht-ink,#172338);caret-color:var(--ht-accent,#2563eb)}.ds-input::placeholder{color:#5f6f85}.ds-input:hover{border-color:#1d4ed8}.ds-input:focus{border-color:var(--ht-accent,#2563eb);box-shadow:0 0 0 2px rgba(5,122,255,.06)}.ds-input:focus-visible{outline:3px solid var(--ht-accent,#2563eb);outline-offset:3px;}"
    },
    {
      "name": "Global navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Navy shell; the current project index is identified by text and an inset underline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-brand\" href=\"#projects\">HyperTest One</a><a class=\"ds-current\" href=\"#projects\" aria-current=\"page\">Projects</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:44px;height:64px;padding:0 36px;background:var(--ht-shell,#0f172a);font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;color:#fff}.ds-nav a{color:#f1f5fc;text-decoration:none}.ds-nav .ds-brand{font-size:17px;font-weight:650;letter-spacing:-.025em;color:#fff}.ds-brand:hover{color:#d8edff}.ds-current{padding:22px 0;font-size:13px;box-shadow:inset 0 -2px #22d3ee}.ds-nav a:focus-visible{outline:3px solid var(--ht-accent,#2563eb);outline-offset:3px;}@media(max-width:640px){.ds-nav{height:60px;padding:0 16px;gap:14px}.ds-nav .ds-brand{font-size:15px}.ds-current{display:none}}"
    },
    {
      "name": "Semantic evidence tag",
      "kind": "chip",
      "refersTo": "tag-success",
      "description": "Verification status uses readable ink and a written label; it is not a run verdict.",
      "html": "<span class=\"ds-tag\">Verified</span>",
      "css": ".ds-tag{display:inline-block;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;line-height:20px;padding:0 7px;border:1px solid #b9d8c3;border-radius:4px;color:#20613d;background:#edf7ef;white-space:normal;overflow-wrap:anywhere}"
    },
    {
      "name": "Decision panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "White bordered work panel with a clear heading, reading text and a supporting metadata line.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-heading\">Quality verdict</h2><h3 class=\"ds-decision\">Awaiting a quality verdict</h3><p class=\"ds-reason\">Official execution, trusted evidence and findings support the recorded decision.</p><span class=\"ds-note\">Task completion does not mean tests passed.</span></section>",
      "css": ".ds-panel{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;padding:22px 24px;border:1px solid var(--ht-line,#d8e1ee);border-radius:10px;background:var(--ht-surface,#ffffff);color:var(--ht-ink,#172338)}.ds-heading{font-size:14px;font-weight:600;margin:0 0 16px}.ds-decision{font-size:25px;font-weight:600;line-height:1.4;letter-spacing:-.025em;color:#526177;margin:4px 0 10px}.ds-reason{font-size:13px;line-height:1.8;max-width:72ch;overflow-wrap:anywhere;margin:8px 0 20px}.ds-note{font-size:11px;color:var(--ht-muted,#526177)}@media(max-width:1199px){.ds-panel{padding:20px}}@media(max-width:640px){.ds-decision{font-size:23px}}"
    },
    {
      "name": "Evidence trail",
      "kind": "custom",
      "refersTo": "evidence-trail",
      "description": "Four section shortcuts form a connected strip; unavailable counts use a dash.",
      "html": "<nav class=\"ds-trail\" aria-label=\"Trace the testing decision\"><button class=\"ds-trail-button\">Executions<span class=\"ds-count\">—</span></button><button class=\"ds-trail-button\">Findings<span class=\"ds-count\">—</span></button><button class=\"ds-trail-button\">Evidence<span class=\"ds-count\">—</span></button><button class=\"ds-trail-button\">Verdicts<span class=\"ds-count\">—</span></button></nav>",
      "css": ".ds-trail{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--ht-line,#d8e1ee);border-radius:8px;background:#edf2fa;overflow:hidden}.ds-trail-button{display:flex;align-items:center;gap:10px;height:50px;padding:0 16px;border:0;border-radius:0;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;font-size:12px;background:transparent;color:var(--ht-ink,#172338);cursor:pointer}.ds-trail-button+.ds-trail-button{border-left:1px solid #d1ddeb}.ds-trail-button:hover{background:rgba(0,0,0,.04)}.ds-trail-button:active{background:rgba(0,0,0,.15)}.ds-trail-button:focus-visible{outline:3px solid var(--ht-accent,#2563eb);outline-offset:3px}.ds-count{margin-left:auto;font-size:16px;font-weight:600;font-variant-numeric:tabular-nums}@media(max-width:640px){.ds-trail{grid-template-columns:repeat(2,minmax(0,1fr))}.ds-trail-button{height:48px}.ds-trail-button:nth-child(3){border-left:0;border-top:1px solid #d1ddeb}.ds-trail-button:nth-child(4){border-top:1px solid #d1ddeb}}"
    },
    {
      "name": "Run section navigation",
      "kind": "nav",
      "refersTo": "run-section-selected",
      "description": "Run sections pair darker selected/active text with the tinted surface; authored focus and Ant Design colorPrimaryBorder share the strong accent outline.",
      "html": "<div class=\"ds-sections\" role=\"tablist\" aria-label=\"Run sections\"><button class=\"ds-section\" role=\"tab\" aria-selected=\"true\">Overview</button><button class=\"ds-section\" role=\"tab\" aria-selected=\"false\">Executions</button><button class=\"ds-section\" role=\"tab\" aria-selected=\"false\">Evidence</button></div>",
      "css": ".ds-sections{display:flex;flex-direction:column;width:160px;font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif}.ds-section{margin:2px 0;padding:11px 14px;text-align:left;border:0;border-radius:6px;font-family:inherit;font-size:14px;background:transparent;color:var(--ht-ink,#172338);cursor:pointer;transition:background-color 160ms ease-out}.ds-section[aria-selected=\"true\"]{background:#dfe9ff;color:#1e40af}.ds-section:hover{color:#1d4ed8}.ds-section:active{color:#1e40af}.ds-sections .ds-section:focus-visible{outline:3px solid var(--ht-accent,#2563eb);outline-offset:3px}@media(max-width:991px){.ds-sections{width:100%;flex-direction:row;overflow-x:auto}.ds-section{margin:0 4px 12px 0;padding:10px 14px;white-space:nowrap}}@media(prefers-reduced-motion:reduce){.ds-section{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Testing Reference Index",
    "overview": "HyperTest One uses a deep navy navigation shell, electric blue actions, cool neutral fields and white work surfaces to make testing records easy to locate and read. The modern technical character comes from precise contrast and a restrained cyan navigation indicator. The reference-index structure remains grounded in consistent identifiers, aligned lists and selected sections. Selected run sections pair darker blue text with pale blue surfaces, and keyboard focus retains a strong accent outline through both authored CSS and the component-library theme.\n\nDaily operation determines the density. Actions have clear hierarchy, supporting metadata stays quiet, and a decision remains close to its reason and evidence. System fonts are a deliberate reading choice for this operating workspace; there is no separate display face or promotional type treatment.",
    "keyCharacteristics": [
      "Navy shell, electric blue actions and flat white work surfaces.",
      "Compact, readable Chinese and English typography.",
      "Traceable identifiers and adjacent evidence links.",
      "Explicit unknown, pending, error and recorded-result states."
    ],
    "rules": [
      {
        "name": "The Signal Cyan Rule",
        "body": "Reserve bright cyan for the current global navigation indicator; retain green, red and amber for their established semantic states.",
        "section": "colors"
      },
      {
        "name": "The State Has Words Rule",
        "body": "Color reinforces a written status and, where present, an icon. An accent color or completed workflow never supplies a quality verdict.",
        "section": "colors"
      },
      {
        "name": "The Action Hierarchy Rule",
        "body": "Keep the complete testing cycle as the principal run action; group secondary planning, execution, gate and input actions in the existing More actions disclosure.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use the navy shell, electric blue actions, white surfaces and existing spacing roles for new operating pages.",
      "Do keep decisions, reasons, record identity and evidence reachable in one reading path.",
      "Do preserve bilingual drafts, selected run sections, loaded results and immutable history during updates.",
      "Do pair state color with readable labels and preserve visible keyboard focus.",
      "Do distinguish unknown, unavailable, zero, task completion and formal quality decisions."
    ],
    "donts": [
      "Don't infer release readiness from task success, coverage counts or an Agent report.",
      "Don't let dense tables or long identifiers create whole-page horizontal overflow.",
      "Don't replace explicit semantic tag overrides with lower-specificity preset styling.",
      "Don't add decorative textures, neon body text or promotional display typography to this operating workspace.",
      "Don't ship synthetic acceptance records in product routes or present frontend fixture checks as a real testing cycle."
    ]
  }
}
