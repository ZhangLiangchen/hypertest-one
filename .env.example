HYPERTEST_ENV=dev
HYPERTEST_DATABASE_URL=postgresql+asyncpg://hypertest:hypertest@localhost:5432/hypertest
HYPERTEST_LOG_LEVEL=INFO
HYPERTEST_API_PREFIX=/api/v1
HYPERTEST_ARTIFACT_ROOT=/workspace/.hypertest-artifacts
HYPERTEST_WORKSPACE_ROOT=/workspace
HYPERTEST_RUNNER_IMAGE=hypertest-runner:py312
HYPERTEST_RUNNER_ALLOW_LOCAL=false
HYPERTEST_WORKER_POLL_SECONDS=1
HYPERTEST_WORKER_LEASE_SECONDS=30
HYPERTEST_WORKER_HEARTBEAT_SECONDS=5
